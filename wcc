#include <stdio.h>

int main(){
    
    int escolha = 0;
    double libras = 0.0f;
    double quilogramas = 0.0f;
    
    printf("-- CALCULADORA CONVERSOR DE PESO --\n");
    
    printf("1. quilogramas para libras\n");
    printf("2. libras para quilogramas\n");
    printf("escolha sua conversão (1 ou 2): ");
    scanf("%d", &escolha);
    
    if(escolha == 1){
        printf("coloque o peso em kg: ");
        scanf("%lf", &quilogramas);
        libras = quilogramas * 2.20462;
        printf("%.2lf quilogramas é igual a %.2f libras\n", quilogramas, libras);
    }
    else if(escolha == 2){
        printf("coloque o peso em libras: ");
        scanf("%lf", &libras);
        quilogramas = libras / 2.20462;
        printf("%.2lf libras é igual a %.2f quilogramas\n", libras, quilogramas);
    }
    else{
        printf("escolha inválida! por favor escolha entre 1 ou 2\n");
    }
    return 0;
}
