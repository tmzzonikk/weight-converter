#include <stdio.h>

int main(){

    int escolha = 0;
    double libras = 0.0;
    double quilogramas = 0.0;
    
    printf("-- CALCULADORA CONVERSOR DE PESO --\n");
    
    printf("1. quilogramas para libras\n");
    printf("2. libras para quilogramas\n");
    printf(".Escolha sua conversão! (1 ou 2): ");
    scanf("%d", &escolha);
    
    switch(escolha){
    case 1:
        printf("coloque o peso em kg:\n");
        scanf("%lf", &quilogramas);
        libras = quilogramas * 2.20462;
        printf("%.2lf em quilogramas é igual a %.2lf libras!!\n", quilogramas, libras);
        break;
    case 2:
        printf("coloque o peso em lbs:\n");
        scanf("%lf", &libras);
        quilogramas = libras / 2.20462;
        printf("%.2lf em libras é igual a %.2lf quilogramas!!\n", libras, quilogramas);
        break;
    default:
        printf("opção inválida!\n");
        break;
    }
   
    return 0;
}
